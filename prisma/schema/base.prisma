generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

enum NotificationType {
  system
  event
  contract
  property
  appointment
  message
  user
}

enum NotificationStatus {
  unread
  read
}

enum UserRole {
  investor
  broker
  admin
  superadmin
}

enum UserActionsStatus {
  seen // seen and no action
  requested // booking created, waiting for approval
  confirmed // scheduled and approved
  completed // appointment done, user visited
  noShow // user did not attend
  canceled // appointment canceled
}

enum ContractStatus {
  draft // contract created but not yet signed
  pending // awaiting approval or payment
  active // signed and currently valid
  suspended // temporarily paused
  expired // reached end date
  terminated // ended early by one or both parties
  completed // fully executed and closed successfully
  canceled // canceled before activation
}

enum ChangeSetStatus {
  draft
  submitted
  approved
  rejected
  applied
  cancelled
}

enum SignatureRole {
  investor
  broker
  admin
}

enum SignatureStatus {
  pending
  signed
  declined
  revoked
}

enum EventStatus {
  DRAFT
  UPCOMING
  OPEN
  // WAITLIST
  ENDED
  CANCELLED
}

/// What period a recorded payment covers. Kept for the payment row itself;
/// the lease-level collection cadence lives in RentFrequency.
enum PaymentType {
  ANNUAL
  SEMI_ANNUAL
  QUARTERLY
  BI_MONTHLY
  MONTHLY
  CUSTOM
}

/// How often rent is collected from a tenant over a 12-month cycle.
/// Drives automatic generation of the RentInstallment schedule.
enum RentFrequency {
  ANNUAL // 1 collection per year
  SEMI_ANNUAL // 2 collections per year
  QUARTERLY // 4 collections per year
  BI_MONTHLY // 6 collections per year (every 2 months)
  MONTHLY // 12 collections per year
  CUSTOM // admin supplies the due dates by hand
}

/// Lifecycle of a single scheduled collection.
/// OVERDUE is deliberately absent — it is derived from dueDate < now
/// so it can never go stale without a cron job.
enum InstallmentStatus {
  PENDING // nothing collected yet
  PARTIAL // some money received, balance outstanding
  PAID // fully settled
  WAIVED // admin forgave this installment
  CANCELLED // schedule changed, this one no longer applies
}

enum EmailVerificationPurpose {
  // Confirms an extra contact email added by the user.
  extra_email
  // "This wasn't me" link from the signup welcome email; consuming it blocks the account.
  disown_signup
}
